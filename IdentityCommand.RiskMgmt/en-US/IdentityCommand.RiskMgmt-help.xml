<helpItems schema="maml" xmlns="http://msh">
  <command:command xmlns:maml="http://schemas.microsoft.com/maml/2004/10" xmlns:command="http://schemas.microsoft.com/maml/dev/command/2004/10" xmlns:dev="http://schemas.microsoft.com/maml/dev/2004/10" xmlns:MSHelp="http://msdn.microsoft.com/mshelp">
    <command:details>
      <command:name>Connect-RMTenant</command:name>
      <command:verb>Connect</command:verb>
      <command:noun>RMTenant</command:noun>
      <maml:description>
        <maml:para>Connects to a Risk Management tenant</maml:para>
      </maml:description>
    </command:details>
    <maml:description>
      <maml:para>Connects to a Risk Management tenant to be able to run IdentityCommand.RiskMgmt module commands against it.</maml:para>
      <maml:para>Provide either the ISPSS shared services subdomain (the Risk Management url is resolved automatically via platform discovery) or the Risk Management tenant url directly.</maml:para>
      <maml:para>If an active `IdentityCommand` session is already present (established with `New-IDSession` or `New-IDPlatformToken`), it is used as-is.</maml:para>
      <maml:para>Supply `-Credential` (or `-SAMLResponse`) and `Connect-RMTenant` will authenticate to CyberArk Identity first, replacing any existing session: the Identity tenant url is discovered from the same subdomain / url via platform discovery, then `New-IDSession` (interactive user, including any MFA challenges) or - with `-PlatformToken` - `New-IDPlatformToken` (OAuth `client_credentials`, for a service user) is invoked.</maml:para>
    </maml:description>
