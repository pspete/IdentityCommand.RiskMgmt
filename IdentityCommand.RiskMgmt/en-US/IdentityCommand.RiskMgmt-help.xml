            <maml:para>The ISPSS shared services subdomain of the Risk Management tenant. The Risk Management url is resolved from platform discovery and used for subsequent operations.</maml:para>
          </maml:description>
          <command:parameterValue required="true" variableLength="false">String</command:parameterValue>
