    <command:examples>
      <command:example>
        <maml:title>-------------------------- Example 1 --------------------------</maml:title>
        <dev:code>Connect-RMTenant -tenant_subdomain sometenant</dev:code>
        <dev:remarks>
          <maml:para>Resolves the Risk Management url for the `sometenant` shared services subdomain and connects to it, using the active `IdentityCommand` session, for subsequent module operations</maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>-------------------------- Example 2 --------------------------</maml:title>
        <dev:code>Connect-RMTenant -tenant_url https://sometenant.compass.cyberark.cloud</dev:code>
        <dev:remarks>
          <maml:para>Connects to the https://sometenant.compass.cyberark.cloud Risk Management tenant, using the active `IdentityCommand` session, for subsequent module operations</maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>-------------------------- Example 3 --------------------------</maml:title>
        <dev:code>Connect-RMTenant -tenant_subdomain sometenant -Credential $Credential</dev:code>
        <dev:remarks>
          <maml:para>When no active `IdentityCommand` session is present, discovers the CyberArk Identity url for the `sometenant` subdomain, authenticates the user in `$Credential` (completing any MFA challenges), resolves the Risk Management url and connects to it</maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>-------------------------- Example 4 --------------------------</maml:title>
        <dev:code>Connect-RMTenant -tenant_subdomain sometenant -Credential $ServiceUserCredential -PlatformToken</dev:code>
        <dev:remarks>
          <maml:para>When no active `IdentityCommand` session is present, authenticates non-interactively as a service user via an OAuth platform token, then connects to the `sometenant` Risk Management tenant</maml:para>
        </dev:remarks>
      </command:example>
    </command:examples>
